{
  "name": "innovation-rh-connect-api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API for Innovation RH Connect",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.cjs",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:deploy": "npm run prisma:deploy",
    "db:seed": "npm run seed:mvp",
    "db:migrate-vps": "node prisma/migrate-vps-db.js",
    "recalc:timetracks": "tsx scripts/recalc-timetracks.ts",
    "seed:admin": "node prisma/seed-admin.cjs",
    "seed:mvp": "node prisma/seed-admin.cjs",
    "seed:pricing": "npx tsx prisma/seed-pricing.ts",
    "seed:realistic-demo": "npx tsx prisma/seed-realistic-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "10.1.1",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@types/bull": "^4.10.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "@willsoto/nestjs-prometheus": "6.1.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "bullmq": "^6.3.2",
    "cache-manager": "7.2.9",
    "cache-manager-ioredis-yet": "2.1.2",
    "clamscan": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "ioredis": "6.0.0",
    "multer": "2.3.0",
    "nest-winston": "1.10.2",
    "nodemailer": "9.0.6",
    "openai": "7.8.0",
    "pdfkit": "0.20.1",
    "prom-client": "15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "winston": "3.19.0",
    "winston-loki": "6.1.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/cron": "2.0.1",
    "@types/jest": "30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "^20.17.32",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.6.0",
    "typescript": "^5.8.3"
  }
}
