# 🧪 Environment de Testes Isolados (Não Conectar em Produção)

# PostgreSQL (docker-compose.test.yml na porta 5436)
DATABASE_URL="postgresql://innovation_test:test_password_123@localhost:5436/innovation_test_db?schema=public"
DIRECT_URL="postgresql://innovation_test:test_password_123@localhost:5436/innovation_test_db?schema=public"

# Redis (docker-compose.test.yml na porta 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=test_redis_secret

# Configurações do App de Teste
PORT=3333
NODE_ENV=test
JWT_SECRET="test_jwt_secret_key_for_automated_testing_only_123456"
FRONTEND_URL="http://localhost:3000"

# IA / OpenAI Mockada para Testes
OPENAI_API_KEY="sk-test-mock-key-do-not-use-in-prod"
OPENAI_AI_ENABLED="true"
OPENAI_MODEL_FAST="gpt-4o-mini"
OPENAI_MODEL_REASONING="o3-mini"
OPENAI_MONTHLY_BUDGET="100.0"

# Playwright E2E
E2E_BASE_URL="http://localhost:3000"
