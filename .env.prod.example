# Copie para .env e substitua todos os valores TROQUE_*.
NODE_ENV=production

POSTGRES_USER=innovation_rh_user
POSTGRES_PASSWORD=TROQUE_SENHA_POSTGRES
POSTGRES_DB=innovation_rh_connect
POSTGRES_HOST_PORT=5435

JWT_SECRET=TROQUE_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=15m
MFA_ENFORCE=true
ALLOWED_ORIGINS=https://seu-dominio.com
PLATFORM_OWNER_EMAIL=proprietario@seu-dominio.com

# E-mail transacional (configure Resend, SES ou SMTP).
MAIL_FROM=no-reply@seu-dominio.com
RESEND_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

API_PORT=3333
WEB_HOST_PORT=3000
APP_URL=https://seu-dominio.com
NEXT_PUBLIC_APP_URL=https://seu-dominio.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_BASE=/api

DOMAIN=seu-dominio.com
CADDY_EMAIL=infra@seu-dominio.com

# Asaas. Chave de PRODUCAO comeca com $aact_prod_ ; de teste com $aact_hmlg_.
# IMPORTANTE: coloque a chave entre ASPAS SIMPLES. Sem aspas o Docker Compose le o "$" como variavel e corta a chave.
#   ASAAS_API_KEY='$aact_prod_000...'
# Deixe ASAAS_API_URL vazio: o sistema escolhe sozinho (chave hmlg -> sandbox; senao producao).
# So preencha se precisar forcar: https://api.asaas.com/v3 (producao) ou https://api-sandbox.asaas.com/v3 (teste).
ASAAS_API_KEY=
ASAAS_API_URL=
# Mesmo valor no Asaas > Integracoes > Webhooks > "Token de autenticacao". URL: https://SEU_DOMINIO/api/finance/webhook/asaas
ASAAS_WEBHOOK_TOKEN=TROQUE_TOKEN_WEBHOOK_COM_PELO_MENOS_32_CARACTERES
ASAAS_WEBHOOK_SECRET=
# UNDEFINED = cliente escolhe Pix, boleto ou cartao na pagina do Asaas.
ASAAS_DEFAULT_BILLING_TYPE=UNDEFINED

# Emitente que aparece no PDF da fatura (a logo ja vai embutida no sistema). Deixe em branco o que nao quiser mostrar.
INVOICE_ISSUER_NAME=Innovation RH
INVOICE_ISSUER_LEGAL_NAME=
INVOICE_ISSUER_DOCUMENT=
INVOICE_ISSUER_ADDRESS=
INVOICE_ISSUER_EMAIL=
INVOICE_ISSUER_PHONE=
INVOICE_ISSUER_SITE=

# Ficha de compensacao do boleto no PDF. O Asaas nao devolve estes campos pela API: copie do boleto OFICIAL
# (Beneficiario, CPF/CNPJ do beneficiario, Agencia / Codigo beneficiario). Tem de ser identico ao que o banco registrou.
INVOICE_BOLETO_BENEFICIARY=
INVOICE_BOLETO_BENEFICIARY_DOCUMENT=
INVOICE_BOLETO_AGENCY=
INVOICE_BOLETO_WALLET=1
INVOICE_BOLETO_SPECIES=DM
INVOICE_BOLETO_ACCEPT=N

# Nota fiscal (NFS-e) automatica pelo Asaas. Antes, preencha Asaas > Notas fiscais > Configuracoes (prefeitura e certificado).
# ID do servico municipal: GET /v3/invoices/municipalServices no Asaas (ou use o codigo + nome do servico).
ASAAS_NFSE_ENABLED=false
ASAAS_NFSE_SERVICE_ID=
ASAAS_NFSE_SERVICE_CODE=
ASAAS_NFSE_SERVICE_NAME=
ASAAS_NFSE_DESCRIPTION=
ASAAS_NFSE_OBSERVATIONS=
# Aliquotas em % (confirme com a contabilidade). Simples Nacional normalmente so ISS.
ASAAS_NFSE_RETAIN_ISS=false
ASAAS_NFSE_ISS=0
ASAAS_NFSE_COFINS=0
ASAAS_NFSE_CSLL=0
ASAAS_NFSE_INSS=0
ASAAS_NFSE_IR=0
ASAAS_NFSE_PIS=0

OPENAI_API_KEY=
OPENAI_AI_ENABLED=true
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MONTHLY_BUDGET=500000
OPENAI_INPUT_COST_PER_1K=0.005
OPENAI_OUTPUT_COST_PER_1K=0.015

PLATFORM_WHATSAPP_SESSION_KEY=innovation-platform
COMPREFACE_URL=
COMPREFACE_API_KEY=
DEV_EMAIL=
DEV_PASSWORD=
ADMIN_PASSWORD=

# --- Pagamentos: provedor ativo (asaas | mercadopago). TambÃ©m dÃ¡ para trocar pelo painel (PUT /api/finance/integrations/provider).
PAYMENT_PROVIDER=asaas

# --- Mercado Pago (Checkout Pro: Pix, cartao, saldo MP)
# Credenciais em: Mercado Pago > Seu negocio > Configuracoes > Credenciais. Token de teste comeca com TEST-.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Chave secreta do webhook (Integracoes > Webhooks). URL: https://SEU_DOMINIO/api/finance/webhook/mercadopago  (evento: Pagamentos)
MERCADOPAGO_WEBHOOK_SECRET=

# --- Gerados por scripts/security/bootstrap-env.sh (nao preencha a mao):
# POSTGRES_USER, POSTGRES_DB, POSTGRES_PASSWORD, REDIS_PASSWORD, JWT_SECRET, KMS_MASTER_KEY (64 hex), TRIAL_DOCUMENT_HASH_SECRET
# --- Informar:
# ALLOWED_ORIGINS=https://seu-dominio.com.br   APP_URL=https://seu-dominio.com.br   PLATFORM_OWNER_EMAIL=...
# --- Backup externo (rclone): BACKUP_REMOTE=b2:bucket/innovation   BACKUP_KEEP_DAYS=14
# --- Carencia de inadimplencia (dias antes de bloquear): BILLING_GRACE_DAYS=15
# --- Monitoramento (opcional): SENTRY_DSN=   LOKI_HOST=

# --- Novidades (RH-R&S, CEO, credenciais) ---
# ID (UUID) do usuario DEV dono da plataforma: SELECT id FROM "User" WHERE email = '...';
PLATFORM_OWNER_USER_ID=
# Validade da senha provisoria em horas (1 a 168)
TEMPORARY_PASSWORD_TTL_HOURS=24
# CEO em onboarding fica restrito. 'off' desliga a restricao (so como saida temporaria)
# CEO_ONBOARDING_ENFORCEMENT=off
# ClamAV (servico 'clamav' do compose). Sem ele, candidatos nao conseguem enviar documentos em producao
CLAMAV_HOST=clamav
CLAMAV_PORT=3310


# CPF/CNPJ obrigatorio e validado no cadastro de empresa. Mude para true SO em homologacao do robo
# (a API le COMPANY_DOCUMENT_OPTIONAL; o site le NEXT_PUBLIC_COMPANY_DOCUMENT_OPTIONAL, variavel de BUILD: rode vps-update.sh).
COMPANY_DOCUMENT_OPTIONAL=false
NEXT_PUBLIC_COMPANY_DOCUMENT_OPTIONAL=false
